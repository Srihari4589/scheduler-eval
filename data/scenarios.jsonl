{"id": "baseline_week", "description": "No correction. Basic mix of constraints: shared attendees, a fixed day, a not-before time, and a soft preference.", "input": {"meetings": [{"id": "design-review", "title": "Design Review", "duration_minutes": 60, "attendees": ["Alice", "Bob"]}, {"id": "sam-1-1", "title": "1:1 with Sam", "duration_minutes": 30, "attendees": ["Alice", "Sam"], "not_after_day": "Wed"}, {"id": "all-hands", "title": "All-hands", "duration_minutes": 45, "attendees": ["Alice", "Bob", "Sam"], "fixed_day": "Fri", "prefer_before": "11:00"}, {"id": "vendor-call", "title": "Vendor Call", "duration_minutes": 30, "attendees": ["Bob"], "not_before": "13:00"}], "blocked_times": [], "notes": "A normal, lightly constrained week."}, "correction": null}
{"id": "add_meeting_midtask", "description": "Mid-task correction adds a new meeting. Tests whether the agent fits it in without breaking earlier constraints.", "input": {"meetings": [{"id": "design-review", "title": "Design Review", "duration_minutes": 60, "attendees": ["Alice", "Bob"]}, {"id": "sam-1-1", "title": "1:1 with Sam", "duration_minutes": 30, "attendees": ["Alice", "Sam"], "not_after_day": "Wed"}, {"id": "all-hands", "title": "All-hands", "duration_minutes": 45, "attendees": ["Alice", "Bob", "Sam"], "fixed_day": "Fri", "prefer_before": "11:00"}, {"id": "vendor-call", "title": "Vendor Call", "duration_minutes": 30, "attendees": ["Bob"], "not_before": "13:00"}], "blocked_times": [], "notes": "A normal week, but expect a follow-up change."}, "correction": {"text": "Actually, can you also add a 30-minute budget review with Bob and Alice sometime this week?", "adds_meeting": {"id": "budget-review", "title": "Budget Review", "duration_minutes": 30, "attendees": ["Alice", "Bob"]}}}
{"id": "attendee_unavailable_midtask", "description": "Sam's two meetings are pinned to Tuesday by a fixed_day rule, so the FIRST schedule is guaranteed to actually put something on Tuesday. The mid-task correction then makes Tuesday unavailable for Sam, so the agent is forced to move those meetings and cannot just leave the original schedule unchanged.", "input": {"meetings": [{"id": "design-review", "title": "Design Review", "duration_minutes": 60, "attendees": ["Alice", "Bob"]}, {"id": "sam-1-1", "title": "1:1 with Sam", "duration_minutes": 30, "attendees": ["Alice", "Sam"], "fixed_day": "Tue"}, {"id": "sam-sync", "title": "Sam / Bob Sync", "duration_minutes": 30, "attendees": ["Sam", "Bob"], "fixed_day": "Tue"}, {"id": "vendor-call", "title": "Vendor Call", "duration_minutes": 30, "attendees": ["Bob"], "not_before": "13:00"}], "blocked_times": [], "notes": "Sam's two meetings are currently set for Tuesday."}, "correction": {"text": "Sam just told me they can't do anything on Tuesday this week after all. Please move anything with Sam off Tuesday, even though it was set for Tuesday before.", "reassign_attendee_unavailable": {"attendee": "Sam", "day": "Tue"}}}
{"id": "remove_meeting_midtask", "description": "Mid-task correction cancels a meeting. Tests that the agent drops it cleanly and does not disturb anything else (also guards the regression check against penalising the cancelled meeting).", "input": {"meetings": [{"id": "design-review", "title": "Design Review", "duration_minutes": 60, "attendees": ["Alice", "Bob"]}, {"id": "offsite-prep", "title": "Offsite Prep", "duration_minutes": 90, "attendees": ["Alice", "Sam"], "fixed_day": "Mon"}, {"id": "sam-1-1", "title": "1:1 with Sam", "duration_minutes": 30, "attendees": ["Alice", "Sam"], "not_after_day": "Wed"}, {"id": "planning", "title": "Planning", "duration_minutes": 60, "attendees": ["Alice", "Bob", "Sam"], "fixed_day": "Thu"}, {"id": "vendor-call", "title": "Vendor Call", "duration_minutes": 30, "attendees": ["Bob"], "not_before": "13:00"}], "blocked_times": [], "notes": "Cancellation follow-up expected."}, "correction": {"text": "Cancel the Thursday planning meeting - take it off the schedule entirely, but keep everything else as it was.", "removes_meeting_id": "planning"}}
{"id": "blocked_time_midtask", "description": "Wednesday afternoon is already blocked, so the two Wednesday-only meetings must sit in the morning. The correction then blocks the start of Wednesday morning, forcing both to shift inside a very tight 90-minute window (exactly enough room).", "input": {"meetings": [{"id": "client-sync", "title": "Client Sync", "duration_minutes": 45, "attendees": ["Alice", "Bob"], "fixed_day": "Wed"}, {"id": "team-retro", "title": "Team Retro", "duration_minutes": 45, "attendees": ["Alice", "Bob", "Sam"], "fixed_day": "Wed"}, {"id": "sam-1-1", "title": "1:1 with Sam", "duration_minutes": 30, "attendees": ["Alice", "Sam"]}, {"id": "vendor-call", "title": "Vendor Call", "duration_minutes": 30, "attendees": ["Bob"], "not_before": "13:00"}], "blocked_times": [{"day": "Wed", "start": "12:00", "end": "17:00", "reason": "Offsite"}], "notes": "Wednesday afternoon is unavailable."}, "correction": {"text": "Actually I have a dentist appointment on Wednesday from 09:00 to 10:30. Please make sure nothing is scheduled then.", "adds_blocked_time": {"day": "Wed", "start": "09:00", "end": "10:30", "reason": "Dentist"}}}
{"id": "dense_week_add_big_meeting", "description": "A crowded week (7 meetings, 4 people, daily lunch blocked) followed by a correction that adds a 2-hour meeting with its own deadline. Tests fitting a big new item in without breaking any earlier rule.", "input": {"meetings": [{"id": "design-review", "title": "Design Review", "duration_minutes": 60, "attendees": ["Alice", "Bob"]}, {"id": "sam-1-1", "title": "1:1 with Sam", "duration_minutes": 30, "attendees": ["Alice", "Sam"], "not_after_day": "Tue"}, {"id": "roadmap", "title": "Roadmap", "duration_minutes": 90, "attendees": ["Alice", "Bob", "Sam"], "fixed_day": "Thu", "prefer_before": "11:00"}, {"id": "vendor-call", "title": "Vendor Call", "duration_minutes": 30, "attendees": ["Bob"], "not_before": "14:00"}, {"id": "hiring-sync", "title": "Hiring Sync", "duration_minutes": 45, "attendees": ["Alice", "Priya"], "not_after_day": "Wed"}, {"id": "qa-triage", "title": "QA Triage", "duration_minutes": 30, "attendees": ["Bob", "Priya"], "prefer_before": "10:00"}, {"id": "all-hands", "title": "All-hands", "duration_minutes": 45, "attendees": ["Alice", "Bob", "Sam", "Priya"], "fixed_day": "Fri", "prefer_before": "11:00"}], "blocked_times": [{"day": "Mon", "start": "12:00", "end": "13:00", "reason": "Lunch"}, {"day": "Tue", "start": "12:00", "end": "13:00", "reason": "Lunch"}, {"day": "Wed", "start": "12:00", "end": "13:00", "reason": "Lunch"}, {"day": "Thu", "start": "12:00", "end": "13:00", "reason": "Lunch"}, {"day": "Fri", "start": "12:00", "end": "13:00", "reason": "Lunch"}], "notes": "A crowded week with lunch blocked every day."}, "correction": {"text": "Please also add a 2-hour Board Prep meeting with Alice and Bob, sometime before Thursday (Mon, Tue or Wed).", "adds_meeting": {"id": "board-prep", "title": "Board Prep", "duration_minutes": 120, "attendees": ["Alice", "Bob"], "not_after_day": "Wed"}}}
